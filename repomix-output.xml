<file path="assets/css/style.css">
/* =====================================================
   CheynTech — Global Stylesheet
   Project: Online Ordering & Delivery Management System
   Tech: Bootstrap 5.3 + Vanilla JS
   ===================================================== */

/* ----- Google Font import (Poppins) ----- */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

/* ----- CSS Custom Properties ----- */
:root {
  --ct-primary:       #e91e8c;
  --ct-primary-dark:  #c2185b;
  --ct-primary-light: #fce4ec;
  --ct-primary-soft:  #fff0f6;

  --ct-white:   #ffffff;
  --ct-bg:      #f8f9fa;
  --ct-text:    #212529;
  --ct-muted:   #6c757d;
  --ct-border:  #dee2e6;

  --ct-radius-sm: 8px;
  --ct-radius:    12px;
  --ct-radius-lg: 20px;

  --ct-shadow:       0 2px 12px rgba(0,0,0,0.08);
  --ct-shadow-pink:  0 6px 24px rgba(233,30,140,0.18);
  --ct-transition:   all 0.25s ease;
}

/* ----- Bootstrap primary override ----- */
.btn-primary   { --bs-btn-bg: var(--ct-primary); --bs-btn-border-color: var(--ct-primary); --bs-btn-hover-bg: var(--ct-primary-dark); --bs-btn-hover-border-color: var(--ct-primary-dark); }
.text-primary  { color: var(--ct-primary) !important; }
.bg-primary    { background-color: var(--ct-primary) !important; }
.border-primary{ border-color: var(--ct-primary) !important; }
a             { color: var(--ct-primary); }
a:hover       { color: var(--ct-primary-dark); }

/* ----- Base ----- */
*, *::before, *::after { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
  font-family: 'Poppins', system-ui, -apple-system, sans-serif;
  font-size: 0.95rem;
  color: var(--ct-text);
  background: #fff;
  min-height: 100vh;
}

img { max-width: 100%; }

/* ===================================================
   NAVBAR
   =================================================== */
.navbar-ct {
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  padding: 0.65rem 0;
  transition: box-shadow 0.3s;
  z-index: 1020;
}

.navbar-ct.scrolled { box-shadow: 0 4px 20px rgba(0,0,0,0.12); }

.navbar-ct .brand-name {
  font-weight: 800;
  font-size: 1.15rem;
  color: var(--ct-primary);
  letter-spacing: -0.3px;
}

.navbar-ct .nav-link {
  font-weight: 500;
  font-size: 0.92rem;
  color: var(--ct-text);
  padding: 0.45rem 0.85rem;
  border-radius: var(--ct-radius-sm);
  transition: var(--ct-transition);
}

.navbar-ct .nav-link:hover,
.navbar-ct .nav-link.active {
  color: var(--ct-primary);
  background: var(--ct-primary-soft);
}

.nav-icons a {
  color: var(--ct-text);
  font-size: 1.25rem;
  transition: var(--ct-transition);
  position: relative;
  display: inline-flex;
  align-items: center;
}

.nav-icons a:hover { color: var(--ct-primary); }

.cart-badge {
  position: absolute;
  top: -7px;
  right: -8px;
  background: var(--ct-primary);
  color: #fff;
  font-size: 0.58rem;
  font-weight: 700;
  min-width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  border: 2px solid #fff;
}

/* toggler */
.navbar-toggler { border: none; padding: 0.25rem; }
.navbar-toggler:focus { box-shadow: none; outline: 2px solid var(--ct-primary); }

/* ===================================================
   SEARCH OVERLAY
   =================================================== */
.search-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10,10,10,0.9);
  z-index: 9998;
  display: none;
  place-items: center;
  padding: 1rem;
  backdrop-filter: blur(4px);
}

.search-overlay.active { display: grid; }

.search-inner {
  width: 100%;
  max-width: 620px;
}

.search-overlay input {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 2px solid var(--ct-primary);
  color: #fff;
  font-size: 1.5rem;
  font-family: 'Poppins', sans-serif;
  outline: none;
  padding: 0.5rem 0;
  caret-color: var(--ct-primary);
}

.search-overlay input::placeholder { color: rgba(255,255,255,0.45); }
.search-hint { color: rgba(255,255,255,0.45); font-size: 0.8rem; margin-top: 0.6rem; }

.search-close {
  position: fixed;
  top: 1.25rem;
  right: 1.5rem;
  color: rgba(255,255,255,0.8);
  font-size: 2rem;
  background: none;
  border: none;
  cursor: pointer;
  line-height: 1;
  transition: var(--ct-transition);
}

.search-close:hover { color: var(--ct-primary); transform: rotate(90deg); }

/* ===================================================
   BREADCRUMB
   =================================================== */
.breadcrumb-wrap {
  background: var(--ct-bg);
  border-bottom: 1px solid var(--ct-border);
  padding: 0.65rem 0;
  font-size: 0.83rem;
}

.breadcrumb-wrap .breadcrumb { margin: 0; }
.breadcrumb-item a { color: var(--ct-muted); text-decoration: none; }
.breadcrumb-item a:hover { color: var(--ct-primary); }
.breadcrumb-item.active { color: var(--ct-text); font-weight: 500; }
.breadcrumb-item + .breadcrumb-item::before { color: var(--ct-muted); }

/* ===================================================
   BUTTONS
   =================================================== */
.btn-ct {
  background: var(--ct-primary);
  color: #fff;
  border: 2px solid var(--ct-primary);
  border-radius: var(--ct-radius-sm);
  font-weight: 600;
  font-family: 'Poppins', sans-serif;
  transition: var(--ct-transition);
  padding: 0.55rem 1.5rem;
  line-height: 1.4;
}

.btn-ct:hover, .btn-ct:focus-visible {
  background: var(--ct-primary-dark);
  border-color: var(--ct-primary-dark);
  color: #fff;
  transform: translateY(-1px);
  box-shadow: var(--ct-shadow-pink);
}

.btn-ct:active { transform: translateY(0); }

.btn-ct-outline {
  background: transparent;
  color: var(--ct-primary);
  border: 2px solid var(--ct-primary);
  border-radius: var(--ct-radius-sm);
  font-weight: 600;
  font-family: 'Poppins', sans-serif;
  transition: var(--ct-transition);
  padding: 0.55rem 1.5rem;
  line-height: 1.4;
}

.btn-ct-outline:hover {
  background: var(--ct-primary);
  color: #fff;
  transform: translateY(-1px);
  box-shadow: var(--ct-shadow-pink);
}

.btn-ct-sm { padding: 0.35rem 1rem; font-size: 0.85rem; }

/* Add to Cart — success feedback state (set via JS for 1.5 s) */
.btn-added,
.btn-added:disabled {
  background: #16a34a !important;
  border-color: #16a34a !important;
  color: #fff !important;
  opacity: 1 !important;
  cursor: default;
  transform: none !important;
  box-shadow: none !important;
}

/* ===================================================
   CONDITION / STATUS BADGES
   =================================================== */
.badge-available    { background: #d1fae5; color: #065f46; font-weight: 600; }
.badge-refurbished  { background: #fef3c7; color: #78350f; font-weight: 600; }
.badge-preowned     { background: #dbeafe; color: #1e3a8a; font-weight: 600; }
.badge-outofstock   { background: #fee2e2; color: #7f1d1d; font-weight: 600; }

.badge-ct {
  display: inline-block;
  padding: 0.25em 0.65em;
  font-size: 0.72rem;
  font-weight: 600;
  border-radius: 999px;
  letter-spacing: 0.02em;
}

/* ===================================================
   PRODUCT CARDS
   =================================================== */
.product-card {
  border: 1.5px solid var(--ct-border);
  border-radius: var(--ct-radius);
  overflow: hidden;
  transition: var(--ct-transition);
  height: 100%;
  background: #fff;
  display: flex;
  flex-direction: column;
}

.product-card:hover {
  box-shadow: var(--ct-shadow-pink);
  transform: translateY(-4px);
  border-color: var(--ct-primary);
}

.product-card .card-img-wrap {
  position: relative;
  background: var(--ct-primary-light);
  aspect-ratio: 1;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-card .card-img-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.35s ease;
}

.product-card:hover .card-img-wrap img { transform: scale(1.05); }

.product-card .card-img-wrap .badge-ct {
  position: absolute;
  top: 0.6rem;
  left: 0.6rem;
}

.product-card .card-body {
  padding: 0.85rem 1rem;
  flex: 1;
  display: flex;
  flex-direction: column;
}

.product-name {
  font-weight: 600;
  font-size: 0.88rem;
  line-height: 1.4;
  margin-bottom: 0.3rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  color: var(--ct-text);
}

.product-price {
  color: var(--ct-primary);
  font-weight: 700;
  font-size: 1.05rem;
  margin-bottom: 0.6rem;
}

.product-card .card-footer {
  background: none;
  border-top: 1px solid var(--ct-border);
  padding: 0.65rem 1rem;
  display: flex;
  gap: 0.4rem;
}

/* ===================================================
   CATEGORY CARDS
   =================================================== */
.category-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2rem 1rem;
  border-radius: var(--ct-radius);
  background: var(--ct-primary-light);
  text-decoration: none;
  transition: var(--ct-transition);
  text-align: center;
  border: 1.5px solid transparent;
}

.category-card:hover {
  background: var(--ct-primary);
  color: #fff;
  transform: translateY(-4px);
  box-shadow: var(--ct-shadow-pink);
}

.category-card .cat-img-wrap {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  background: rgba(255,255,255,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 1rem;
  overflow: hidden;
  transition: var(--ct-transition);
}

.category-card:hover .cat-img-wrap { background: rgba(255,255,255,0.25); }

.category-card .cat-img-wrap img { width: 52px; height: 52px; object-fit: contain; }
.category-card .cat-icon { font-size: 2.2rem; color: var(--ct-primary); transition: var(--ct-transition); }
.category-card:hover .cat-icon { color: #fff; }

.category-card .cat-name {
  font-weight: 700;
  font-size: 0.92rem;
  color: var(--ct-text);
  transition: var(--ct-transition);
  margin-bottom: 0.2rem;
}

.category-card:hover .cat-name { color: #fff; }

.category-card .cat-count {
  font-size: 0.78rem;
  color: var(--ct-muted);
  transition: var(--ct-transition);
}

.category-card:hover .cat-count { color: rgba(255,255,255,0.75); }

/* ===================================================
   SECTION HEADINGS
   =================================================== */
.section-header { margin-bottom: 2rem; }
.section-header .section-label {
  display: inline-block;
  font-size: 0.78rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--ct-primary);
  margin-bottom: 0.35rem;
}
.section-header .section-title {
  font-weight: 800;
  font-size: 1.65rem;
  color: var(--ct-text);
  margin: 0;
  line-height: 1.25;
}
.section-header .section-subtitle { color: var(--ct-muted); margin-top: 0.4rem; font-size: 0.9rem; }

/* ===================================================
   HERO SECTION
   =================================================== */
.hero-section {
  background: linear-gradient(135deg, var(--ct-primary-light) 0%, #fff8fb 40%, #fff 70%);
  padding: 5rem 0 4rem;
  position: relative;
  overflow: hidden;
}

.hero-section::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 75% 50%, rgba(233,30,140,0.06) 0%, transparent 65%);
  pointer-events: none;
}

.hero-section h1 {
  font-size: clamp(1.75rem, 4vw, 2.8rem);
  font-weight: 800;
  line-height: 1.2;
  letter-spacing: -0.5px;
}

.hero-section h1 .highlight { color: var(--ct-primary); }

.hero-section p.lead {
  font-size: 1rem;
  color: var(--ct-muted);
  max-width: 480px;
  line-height: 1.7;
}

.hero-product-img {
  max-height: 400px;
  object-fit: contain;
  filter: drop-shadow(0 20px 40px rgba(233,30,140,0.25));
  animation: heroFloat 3s ease-in-out infinite;
}

@keyframes heroFloat {
  0%, 100% { transform: translateY(0); }
  50%       { transform: translateY(-10px); }
}

/* ===================================================
   FILTER SIDEBAR
   =================================================== */
.filter-sidebar { font-size: 0.9rem; }

.filter-sidebar .filter-group {
  padding-bottom: 1rem;
  margin-bottom: 1rem;
  border-bottom: 1px solid var(--ct-border);
}

.filter-sidebar .filter-group:last-child { border-bottom: none; }

.filter-sidebar .filter-title {
  font-weight: 700;
  font-size: 0.88rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--ct-text);
  margin-bottom: 0.75rem;
}

.filter-sidebar .form-check-label { cursor: pointer; }

.color-swatch {
  display: inline-block;
  width: 20px; height: 20px;
  border-radius: 50%;
  border: 2px solid var(--ct-border);
  vertical-align: middle;
  margin-right: 0.35rem;
}

/* ===================================================
   ORDER STEPPER (Track Order)
   =================================================== */
.order-stepper {
  display: flex;
  position: relative;
  padding-bottom: 0.5rem;
}

/* connecting line */
.order-stepper::before {
  content: '';
  position: absolute;
  top: 18px;
  left: calc(10% + 10px);
  right: calc(10% + 10px);
  height: 3px;
  background: var(--ct-border);
  z-index: 0;
}

.order-stepper .step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-circle {
  width: 38px; height: 38px;
  border-radius: 50%;
  border: 3px solid var(--ct-border);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.95rem;
  color: var(--ct-muted);
  margin-bottom: 0.6rem;
  transition: var(--ct-transition);
  font-weight: 700;
}

.step.completed .step-circle {
  background: var(--ct-primary);
  border-color: var(--ct-primary);
  color: #fff;
}

.step.active .step-circle {
  border-color: var(--ct-primary);
  color: var(--ct-primary);
  box-shadow: 0 0 0 5px var(--ct-primary-light);
}

.step-label {
  font-size: 0.72rem;
  text-align: center;
  color: var(--ct-muted);
  max-width: 75px;
  line-height: 1.3;
}

.step.completed .step-label,
.step.active .step-label { color: var(--ct-primary); font-weight: 600; }

/* stepper fill line */
.order-stepper .step-fill {
  position: absolute;
  top: 18px;
  left: 0;
  height: 3px;
  background: var(--ct-primary);
  z-index: 0;
  transition: width 0.5s ease;
}

/* ===================================================
   ADMIN SIDEBAR
   =================================================== */
.admin-layout { display: flex; min-height: 100vh; }

.admin-sidebar {
  width: 250px;
  background: #1a1a2e;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  overflow-y: auto;
  z-index: 100;
  transition: transform 0.3s;
}

.admin-sidebar .sidebar-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 1.25rem 1.25rem;
  border-bottom: 1px solid rgba(255,255,255,0.08);
  text-decoration: none;
}

.admin-sidebar .brand-name { color: #fff; font-weight: 700; font-size: 1.05rem; }

.admin-sidebar .sidebar-section-label {
  color: rgba(255,255,255,0.35);
  font-size: 0.68rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 1rem 1.25rem 0.4rem;
  font-weight: 600;
}

.admin-sidebar .nav-link {
  color: rgba(255,255,255,0.65);
  padding: 0.65rem 1.25rem;
  font-size: 0.9rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  border-left: 3px solid transparent;
  transition: var(--ct-transition);
  text-decoration: none;
}

.admin-sidebar .nav-link i { font-size: 1rem; width: 1.1rem; }
.admin-sidebar .nav-link:hover { color: #fff; background: rgba(255,255,255,0.06); }
.admin-sidebar .nav-link.active { color: #fff; background: rgba(233,30,140,0.15); border-left-color: var(--ct-primary); }

.admin-content {
  margin-left: 250px;
  flex: 1;
  background: #f5f6fa;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.admin-topbar {
  background: #fff;
  border-bottom: 1px solid var(--ct-border);
  padding: 0.85rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 50;
}

.admin-topbar h5 { margin: 0; font-weight: 700; font-size: 1.05rem; }

.admin-main { padding: 1.5rem; flex: 1; }

.stat-card {
  background: #fff;
  border-radius: var(--ct-radius);
  padding: 1.25rem 1.5rem;
  border: 1px solid var(--ct-border);
  display: flex;
  align-items: center;
  gap: 1rem;
  transition: var(--ct-transition);
}

.stat-card:hover { box-shadow: var(--ct-shadow); transform: translateY(-2px); }

.stat-icon {
  width: 52px; height: 52px;
  border-radius: var(--ct-radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  flex-shrink: 0;
}

.stat-icon.pink-soft { background: var(--ct-primary-light); color: var(--ct-primary); }
.stat-icon.blue-soft { background: #dbeafe; color: #1d4ed8; }
.stat-icon.green-soft { background: #d1fae5; color: #065f46; }
.stat-icon.yellow-soft { background: #fef3c7; color: #92400e; }

.stat-value { font-size: 1.6rem; font-weight: 800; line-height: 1.1; color: var(--ct-text); }
.stat-label { font-size: 0.78rem; color: var(--ct-muted); font-weight: 500; }

/* ===================================================
   TOAST NOTIFICATION
   =================================================== */
.toast-ct {
  position: fixed;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: #1a1a2e;
  color: #fff;
  padding: 0.75rem 1.5rem;
  border-radius: 999px;
  font-size: 0.88rem;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  z-index: 9999;
  box-shadow: 0 8px 30px rgba(0,0,0,0.25);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.34,1.56,0.64,1), opacity 0.3s ease;
  pointer-events: none;
  white-space: nowrap;
}

.toast-ct.show {
  transform: translateX(-50%) translateY(0);
  opacity: 1;
}

.toast-ct.toast-success { background: #065f46; }
.toast-ct.toast-error   { background: #7f1d1d; }
.toast-ct.toast-info    { background: var(--ct-primary); }

/* ===================================================
   BACK TO TOP
   =================================================== */
#backToTop {
  position: fixed;
  bottom: 2rem;
  right: 1.5rem;
  width: 44px; height: 44px;
  border-radius: 50%;
  background: var(--ct-primary);
  color: #fff;
  border: none;
  font-size: 1.1rem;
  display: none;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 15px rgba(233,30,140,0.35);
  z-index: 998;
  transition: var(--ct-transition);
  cursor: pointer;
}

#backToTop.visible { display: flex; }
#backToTop:hover   { transform: translateY(-3px); box-shadow: 0 6px 20px rgba(233,30,140,0.45); }

/* ===================================================
   FOOTER
   =================================================== */
.site-footer {
  background: #1a1a2e;
  color: rgba(255,255,255,0.65);
  padding: 3.5rem 0 0;
  font-size: 0.88rem;
}

.site-footer .footer-brand-name { color: #fff; font-weight: 800; font-size: 1.05rem; }
.site-footer p { line-height: 1.7; }

.site-footer .footer-heading {
  color: #fff;
  font-weight: 700;
  font-size: 0.85rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 1rem;
}

.site-footer .footer-links a {
  color: rgba(255,255,255,0.6);
  text-decoration: none;
  display: block;
  padding: 0.2rem 0;
  transition: var(--ct-transition);
}

.site-footer .footer-links a:hover { color: var(--ct-primary); padding-left: 0.25rem; }

.site-footer .social-links a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px; height: 36px;
  border-radius: 50%;
  background: rgba(255,255,255,0.08);
  color: rgba(255,255,255,0.7);
  transition: var(--ct-transition);
  font-size: 0.95rem;
}

.site-footer .social-links a:hover { background: var(--ct-primary); color: #fff; }

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 1.1rem 0;
  margin-top: 2.5rem;
  font-size: 0.8rem;
  color: rgba(255,255,255,0.4);
}

/* ===================================================
   FORMS
   =================================================== */
.form-control:focus, .form-select:focus {
  border-color: var(--ct-primary);
  box-shadow: 0 0 0 0.2rem rgba(233,30,140,0.15);
}

.form-check-input:checked {
  background-color: var(--ct-primary);
  border-color: var(--ct-primary);
}

.form-check-input:focus {
  box-shadow: 0 0 0 0.2rem rgba(233,30,140,0.2);
}

/* ===================================================
   RESPONSIVE TWEAKS
   =================================================== */
@media (max-width: 991.98px) {
  .admin-sidebar { transform: translateX(-100%); }
  .admin-sidebar.open { transform: translateX(0); }
  .admin-content { margin-left: 0; }
  .admin-topbar { top: 0; }

  .navbar-ct .navbar-collapse {
    border-top: 1px solid var(--ct-border);
    padding: 0.75rem 0;
    margin-top: 0.5rem;
  }
  .nav-icons { margin-top: 0.75rem; }
}

@media (max-width: 767.98px) {
  .hero-section { padding: 3rem 0; }
  .hero-product-img { max-height: 240px; }
  .category-card { padding: 1.25rem 0.75rem; }
  .order-stepper .step-label { font-size: 0.65rem; max-width: 60px; }
}

@media (max-width: 575.98px) {
  .section-header .section-title { font-size: 1.35rem; }
}

/* ===================================================
   HOME PAGE — Marquee Ticker
   =================================================== */
.marquee-section {
  background: var(--ct-primary-soft);
  border-top: 1px solid var(--ct-primary-light);
  border-bottom: 1px solid var(--ct-primary-light);
  padding: 0.65rem 0;
}

.marquee-wrap  { overflow: hidden; }

.marquee-track {
  display: flex;
  gap: 1.5rem;
  width: max-content;
  animation: marquee 22s linear infinite;
}

.marquee-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  background: var(--ct-primary-soft);
  border: 1px solid var(--ct-primary-light);
  border-radius: 999px;
  padding: 0.35rem 1rem;
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--ct-primary);
  white-space: nowrap;
}

@keyframes marquee {
  0%   { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

/* ===================================================
   HOME PAGE — Hero micro-label
   =================================================== */
.hero-eyebrow {
  font-size: 0.82rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--ct-primary);
}

/* ===================================================
   HOME PAGE — Feature / Why-Choose-Us cards
   =================================================== */
.feature-icon-wrap {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: var(--ct-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  color: var(--ct-primary);
  margin: 0 auto 1rem;
  transition: var(--ct-transition);
  flex-shrink: 0;
}

.feature-icon-wrap.feature-icon-white {
  background: #fff;
  box-shadow: var(--ct-shadow-pink);
}

.feature-card {
  padding: 2rem 1.25rem;
  border-radius: var(--ct-radius);
  text-align: center;
  transition: var(--ct-transition);
  border: 1.5px solid var(--ct-border);
  background: #fff;
  height: 100%;
}

.feature-card:hover {
  border-color: var(--ct-primary);
  transform: translateY(-4px);
  box-shadow: var(--ct-shadow-pink);
}

.feature-card:hover .feature-icon-wrap { background: var(--ct-primary); color: #fff; }

.feature-card h5,
.feature-card .feature-title { font-size: 1rem; font-weight: 700; }

.step-title { font-size: 0.92rem; font-weight: 700; margin-bottom: 0.25rem; }

/* ===================================================
   HOME PAGE — Section divider
   =================================================== */
.section-divider { border-top: 1px solid var(--ct-border); margin: 0; }

/* ===================================================
   HOME PAGE — Testimonial cards
   =================================================== */
.testimonial-card {
  background: #fff;
  border: 1.5px solid var(--ct-border);
  border-radius: var(--ct-radius);
  padding: 1.5rem;
  transition: var(--ct-transition);
  height: 100%;
}

.testimonial-card:hover { box-shadow: var(--ct-shadow); }
.testimonial-card .stars { color: #f59e0b; font-size: 0.9rem; }

/* ===================================================
   HOME PAGE — CTA Banner section
   =================================================== */
.cta-section {
  background: linear-gradient(135deg, var(--ct-primary) 0%, var(--ct-primary-dark) 100%);
  padding: 5rem 0;
}

.cta-section h2 {
  font-size: clamp(1.5rem, 3vw, 2.25rem);
  font-weight: 800;
}

.btn-cta-light {
  background: #fff;
  color: var(--ct-primary);
  font-weight: 600;
  border-radius: var(--ct-radius-sm);
  padding: 0.6rem 2rem;
  border: none;
  transition: var(--ct-transition);
}

.btn-cta-light:hover { background: var(--ct-primary-light); color: var(--ct-primary-dark); }

.btn-cta-outline-light {
  background: rgba(255,255,255,0.12);
  color: #fff;
  font-weight: 600;
  border: 2px solid rgba(255,255,255,0.85);
  border-radius: var(--ct-radius-sm);
  padding: 0.6rem 2rem;
  transition: var(--ct-transition);
}

.btn-cta-outline-light:hover { background: rgba(255,255,255,0.25); border-color: #fff; color: #fff; }

/* ===================================================
   SHARED — Avatar initials circle
   =================================================== */
.avatar-circle {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: var(--ct-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ct-primary);
  font-weight: 700;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.testimonial-name  { font-size: 0.88rem; font-weight: 600; }
.testimonial-place { font-size: 0.75rem; }

/* ===================================================
   ADMIN — Table
   =================================================== */
.admin-th { font-size: 0.78rem; font-weight: 700; }

.admin-card {
  background: #fff;
  border: 1px solid var(--ct-border);
  border-radius: var(--ct-radius);
}

.admin-card .card-body { padding: 1.25rem 1.5rem; }

.order-count-card {
  background: #fff;
  border: none;
  border-radius: var(--ct-radius);
  box-shadow: 0 1px 4px rgba(0,0,0,0.06);
  text-align: center;
  padding: 0.75rem 0.5rem;
}

.stat-count-sm   { font-size: 1.4rem; font-weight: 800; color: var(--ct-text); line-height: 1.1; }
.stat-label-sm   { font-size: 0.72rem; color: var(--ct-muted); font-weight: 500; }

/* ===================================================
   ADMIN — Sidebar overlay + states
   =================================================== */
#sidebarOverlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 99;
  display: none;
}

#sidebarOverlay.active { display: block; }

.sidebar-logout   { color: #f87171 !important; }
.sidebar-disabled { opacity: 0.4; pointer-events: none; }

/* ===================================================
   ADMIN — Topbar user avatar
   =================================================== */
.admin-user-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--ct-primary);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.85rem;
  flex-shrink: 0;
}

.admin-username { font-size: 0.88rem; font-weight: 600; }

/* ===================================================
   ADMIN — Product images in tables / modals
   =================================================== */
.product-thumb {
  width: 48px;
  height: 48px;
  border-radius: var(--ct-radius-sm);
  object-fit: cover;
}

.product-thumb-sm {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  object-fit: cover;
}

.img-preview {
  width: 60px;
  height: 60px;
  border-radius: var(--ct-radius-sm);
  object-fit: cover;
}

/* ===================================================
   CART BADGE — hidden initially; JS shows when count > 0
   =================================================== */
.cart-badge { display: none; }

/* ===================================================
   MISC
   =================================================== */
.text-xs  { font-size: 0.76rem; }
.text-sm  { font-size: 0.85rem; }
.lh-tight { line-height: 1.3; }

/* ===================================================
   UTILITIES
   =================================================== */
.text-ct   { color: var(--ct-primary) !important; }
.bg-ct     { background-color: var(--ct-primary) !important; }
.bg-ct-soft{ background-color: var(--ct-primary-soft) !important; }
.bg-ct-light { background-color: var(--ct-primary-light) !important; }

.rounded-ct    { border-radius: var(--ct-radius) !important; }
.rounded-ct-lg { border-radius: var(--ct-radius-lg) !important; }

.fw-800 { font-weight: 800 !important; }
.fw-700 { font-weight: 700 !important; }

/* Page transition shimmer skeleton */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
  border-radius: var(--ct-radius-sm);
}

@keyframes shimmer {
  0%   { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===================================================
   CATALOG PAGE
   =================================================== */
.catalog-hero {
  background: linear-gradient(135deg, var(--ct-primary-light) 0%, #fff8fb 60%, #fff 100%);
  padding: 2.5rem 0 2rem;
  border-bottom: 1px solid var(--ct-border);
}

.catalog-hero h1     { font-size: 1.65rem; font-weight: 800; margin: 0; }
.catalog-result-count { font-size: 0.88rem; color: var(--ct-muted); margin: 0; }

.filter-card {
  background: #fff;
  border: 1.5px solid var(--ct-border);
  border-radius: var(--ct-radius);
  padding: 1.25rem;
  position: sticky;
  top: 76px;
}

.filter-title-bar { font-weight: 800; font-size: 0.92rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ct-text); margin-bottom: 1rem; padding-bottom: 0.65rem; border-bottom: 2px solid var(--ct-primary-light); display: flex; align-items: center; justify-content: space-between; }
.filter-title-bar a { font-size: 0.75rem; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ct-muted); text-decoration: none; }
.filter-title-bar a:hover { color: var(--ct-primary); }

.filter-group-label { font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ct-text); margin-bottom: 0.6rem; }
.filter-group { margin-bottom: 1.1rem; padding-bottom: 1.1rem; border-bottom: 1px solid var(--ct-border); }
.filter-group:last-child { border-bottom: none; margin-bottom: 0; padding-bottom: 0; }
.filter-check .form-check { margin-bottom: 0.3rem; }
.filter-check .form-check-label { font-size: 0.87rem; cursor: pointer; }

.color-option { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.35rem; cursor: pointer; }
.color-dot    { width: 18px; height: 18px; border-radius: 50%; border: 2px solid rgba(0,0,0,0.12); display: inline-block; flex-shrink: 0; }
.color-label  { font-size: 0.87rem; }

.price-inputs { display: flex; align-items: center; gap: 0.5rem; }
.price-inputs .form-control { font-size: 0.85rem; border-radius: var(--ct-radius-sm); padding: 0.35rem 0.6rem; }
.price-sep    { color: var(--ct-muted); font-size: 0.85rem; flex-shrink: 0; }
.price-symbol { font-size: 0.82rem; color: var(--ct-muted); }

.catalog-search-wrap { position: relative; margin-bottom: 1rem; }
.catalog-search-wrap input { padding-right: 2.4rem; border-radius: var(--ct-radius-sm); font-size: 0.88rem; }
.catalog-search-wrap .search-icon { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--ct-muted); font-size: 0.95rem; pointer-events: none; }

.sort-bar { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius-sm); padding: 0.6rem 1rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
.sort-label { font-size: 0.85rem; color: var(--ct-muted); white-space: nowrap; }

.page-link { border-radius: var(--ct-radius-sm) !important; color: var(--ct-primary); border-color: var(--ct-border); font-size: 0.88rem; font-weight: 600; padding: 0.45rem 0.8rem; }
.page-link:hover { background: var(--ct-primary-light); border-color: var(--ct-primary); color: var(--ct-primary); }
.page-item.active .page-link   { background: var(--ct-primary); border-color: var(--ct-primary); }
.page-item.disabled .page-link { color: var(--ct-muted); }

.filter-mobile-btn { display: none; }
@media (max-width: 991.98px) { .filter-col { display: none; } .filter-mobile-btn { display: flex; } }

.offcanvas-filter .offcanvas-header { border-bottom: 1px solid var(--ct-border); }
.offcanvas-filter .offcanvas-title  { font-weight: 800; font-size: 1rem; }
.offcanvas-filter .offcanvas-body   { padding: 1.25rem; }

.active-filters { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 0.85rem; }
.filter-tag { background: var(--ct-primary-light); color: var(--ct-primary); border: 1px solid rgba(233,30,140,0.2); border-radius: 999px; font-size: 0.75rem; font-weight: 600; padding: 0.2em 0.75em 0.2em 0.65em; display: inline-flex; align-items: center; gap: 0.35rem; }
.filter-tag button { background: none; border: none; padding: 0; color: var(--ct-primary); cursor: pointer; font-size: 0.85rem; line-height: 1; opacity: 0.7; }
.filter-tag button:hover { opacity: 1; }

.product-desc { font-size: 0.8rem; color: var(--ct-muted); margin-bottom: 0.5rem; line-height: 1.5; }

/* ===================================================
   CART PAGE
   =================================================== */
.cart-section    { padding: 2.5rem 0 4rem; }
.cart-page-title { font-weight: 800; font-size: 1.6rem; }
.cart-page-title-icon { color: var(--ct-primary); }

.cart-item-card { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 1.1rem 1.25rem; display: flex; align-items: center; gap: 1rem; transition: var(--ct-transition); }
.cart-item-card:hover { border-color: var(--ct-primary); box-shadow: var(--ct-shadow); }
.cart-item-img     { width: 88px; height: 88px; border-radius: var(--ct-radius-sm); object-fit: cover; background: var(--ct-primary-light); flex-shrink: 0; }
.cart-item-info    { flex: 1; min-width: 0; }
.cart-item-name    { font-weight: 700; font-size: 0.95rem; color: var(--ct-text); margin-bottom: 0.15rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cart-item-variant { font-size: 0.8rem; color: var(--ct-muted); margin-bottom: 0.35rem; }

.qty-stepper { display: inline-flex; align-items: center; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius-sm); overflow: hidden; user-select: none; }
.qty-stepper button { background: none; border: none; padding: 0.3rem 0.65rem; font-size: 1.1rem; line-height: 1; cursor: pointer; color: var(--ct-text); transition: background 0.15s; }
.qty-stepper button:hover { background: var(--ct-primary-light); color: var(--ct-primary); }
.qty-stepper .qty-val { min-width: 32px; text-align: center; font-weight: 700; font-size: 0.88rem; border-left: 1.5px solid var(--ct-border); border-right: 1.5px solid var(--ct-border); padding: 0.3rem 0; }

.cart-item-price { font-weight: 800; color: var(--ct-primary); font-size: 1rem; white-space: nowrap; }
.cart-item-unit  { font-size: 0.75rem; color: var(--ct-muted); }
.btn-remove      { background: none; border: none; color: var(--ct-muted); font-size: 1.15rem; cursor: pointer; padding: 0.3rem 0.5rem; border-radius: var(--ct-radius-sm); transition: var(--ct-transition); flex-shrink: 0; }
.btn-remove:hover { color: #dc3545; background: #fee2e2; }

.summary-card  { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 1.5rem; position: sticky; top: 90px; }
.summary-title { font-weight: 800; font-size: 1.05rem; margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--ct-border); }
.summary-title-icon { color: var(--ct-primary); }
.summary-row   { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.7rem; font-size: 0.9rem; }
.summary-row .label      { color: var(--ct-muted); }
.summary-row .value      { font-weight: 600; }
.summary-row .value-note { font-size: 0.8rem; }
.summary-total { display: flex; justify-content: space-between; align-items: center; padding-top: 0.9rem; margin-top: 0.5rem; border-top: 2px solid var(--ct-border); font-weight: 800; font-size: 1.05rem; }
.summary-total .value { color: var(--ct-primary); font-size: 1.25rem; }
.checkout-btn { font-size: 1rem; }

.shipping-note { background: var(--ct-primary-light); border-radius: var(--ct-radius-sm); padding: 0.65rem 0.85rem; font-size: 0.8rem; color: #c2185b; display: flex; gap: 0.4rem; align-items: flex-start; margin-bottom: 1rem; }
.secure-note   { font-size: 0.75rem; color: var(--ct-muted); text-align: center; margin-top: 0.65rem; }

.empty-cart     { text-align: center; padding: 4rem 1rem; }
.empty-icon     { width: 100px; height: 100px; border-radius: 50%; background: var(--ct-primary-light); display: flex; align-items: center; justify-content: center; font-size: 2.8rem; color: var(--ct-primary); margin: 0 auto 1.5rem; }
.empty-cart h3  { font-weight: 800; font-size: 1.4rem; margin-bottom: 0.5rem; }
.continue-link  { font-size: 0.88rem; color: var(--ct-muted); text-decoration: none; font-weight: 600; }
.continue-link:hover { color: var(--ct-primary); }

@keyframes pulse-ring { 0% { box-shadow: 0 0 0 0 rgba(233,30,140,0.4); } 70% { box-shadow: 0 0 0 10px rgba(233,30,140,0); } 100% { box-shadow: 0 0 0 0 rgba(233,30,140,0); } }
.step.active .step-circle { animation: pulse-ring 1.6s ease-out infinite; }
@media (max-width: 575.98px) { .cart-item-card { flex-wrap: wrap; } .cart-item-img { width: 70px; height: 70px; } }

/* ===================================================
   CHECKOUT PAGE
   =================================================== */
.checkout-section     { padding: 2.5rem 0 4rem; }
.checkout-step-heading { font-weight: 700; font-size: 1rem; margin-bottom: 1rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--ct-primary-light); color: var(--ct-text); }
.checkout-step-num    { display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: var(--ct-primary); color: #fff; font-size: 0.78rem; font-weight: 700; margin-right: 0.5rem; flex-shrink: 0; }

.option-card { border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius-sm); padding: 1rem; cursor: pointer; transition: var(--ct-transition); display: flex; align-items: flex-start; gap: 0.75rem; }
.option-card:hover { border-color: var(--ct-primary); }
.option-card.selected { border-color: var(--ct-primary); background: var(--ct-primary-soft); }
.option-card .option-icon   { font-size: 1.25rem; color: var(--ct-primary); flex-shrink: 0; margin-top: 0.1rem; }
.option-card .option-title  { font-weight: 700; font-size: 0.9rem; margin-bottom: 0.15rem; }
.option-card .option-detail { font-size: 0.8rem; color: var(--ct-muted); }

.delivery-address-fields { display: none; }
.delivery-address-fields.visible { display: block; }

.payment-instructions { display: none; background: var(--ct-primary-light); border-radius: var(--ct-radius-sm); padding: 0.85rem 1rem; font-size: 0.85rem; margin-top: 0.75rem; }
.payment-instructions.visible { display: block; }
.payment-instructions strong { color: var(--ct-primary-dark); }

.checkout-summary-card  { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 1.25rem; position: sticky; top: 90px; }
.checkout-summary-item  { display: flex; justify-content: space-between; align-items: start; padding: 0.5rem 0; border-bottom: 1px solid var(--ct-border); font-size: 0.88rem; }
.checkout-summary-item:last-of-type { border-bottom: none; }
.checkout-item-name  { font-weight: 600; }
.checkout-item-meta  { font-size: 0.76rem; color: var(--ct-muted); }
.checkout-item-price { font-weight: 700; color: var(--ct-primary); white-space: nowrap; }

.trust-badge   { display: flex; flex-direction: column; align-items: center; font-size: 0.72rem; color: var(--ct-muted); text-align: center; gap: 0.25rem; }
.trust-badge i { font-size: 1.2rem; color: var(--ct-primary); }

/* ===================================================
   TRACK ORDER PAGE
   =================================================== */
.track-hero   { background: linear-gradient(135deg, var(--ct-primary-light) 0%, #fff 60%); padding: 3rem 0 2rem; }
.track-hero h1 { font-weight: 800; font-size: 1.85rem; }

.track-form-card { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 2rem; max-width: 560px; margin: 0 auto; }

.track-result         { display: none; }
.track-result.visible { display: block; }

.order-info-card    { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); overflow: hidden; }
.order-info-header  { background: var(--ct-primary); color: #fff; padding: 1rem 1.5rem; }
.order-info-id      { font-weight: 800; font-size: 1.1rem; }
.order-info-body    { padding: 1.5rem; }

.status-history-item { display: flex; gap: 0.75rem; align-items: flex-start; padding: 0.75rem 0; border-bottom: 1px solid var(--ct-border); }
.status-history-item:last-child { border-bottom: none; }
.status-dot       { width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 2px; }
.status-dot-done  { background: var(--ct-primary-light); color: var(--ct-primary); }
.status-history-label { font-weight: 600; font-size: 0.88rem; }
.status-history-time  { font-size: 0.76rem; color: var(--ct-muted); }
.status-history-note  { font-size: 0.82rem; }

/* ===================================================
   CONTACT PAGE
   =================================================== */
.contact-section   { padding: 3rem 0 5rem; }
.contact-form-card { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 2rem; }
.contact-info-card { background: var(--ct-primary-soft); border: 1.5px solid var(--ct-primary-light); border-radius: var(--ct-radius); padding: 1.5rem; height: 100%; }

.contact-info-item       { display: flex; align-items: flex-start; gap: 0.75rem; padding: 0.65rem 0; border-bottom: 1px solid rgba(233,30,140,0.12); font-size: 0.9rem; }
.contact-info-item:last-of-type { border-bottom: none; }
.contact-info-icon       { font-size: 1.1rem; color: var(--ct-primary); flex-shrink: 0; margin-top: 0.1rem; }
.contact-info-label      { font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ct-muted); margin-bottom: 0.1rem; }
.contact-info-value      { font-weight: 500; }

.map-placeholder { background: var(--ct-border); border-radius: var(--ct-radius-sm); height: 160px; display: flex; align-items: center; justify-content: center; flex-direction: column; color: var(--ct-muted); font-size: 0.85rem; gap: 0.4rem; margin-top: 1rem; }
.map-placeholder i { font-size: 2rem; }

/* ===================================================
   LOGIN / REGISTER PAGE
   =================================================== */
.auth-page        { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--ct-primary-soft); padding: 2rem 1rem; }
.auth-brand       { display: flex; align-items: center; gap: 0.6rem; margin-bottom: 1.5rem; text-decoration: none; }
.auth-brand-name  { font-weight: 800; font-size: 1.25rem; color: var(--ct-primary); }
.auth-card        { background: #fff; border-radius: var(--ct-radius-lg); box-shadow: 0 8px 40px rgba(0,0,0,0.1); padding: 2rem 2.5rem; width: 100%; max-width: 460px; }
.auth-footer      { margin-top: 1.25rem; font-size: 0.78rem; color: var(--ct-muted); }
.password-wrap    { position: relative; }
.password-wrap .form-control { padding-right: 2.75rem; }
.password-toggle  { position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--ct-muted); cursor: pointer; padding: 0; font-size: 1rem; line-height: 1; }
.password-toggle:hover { color: var(--ct-primary); }

/* ===================================================
   ABOUT PAGE
   =================================================== */
.about-hero    { background: #1a1a2e; color: #fff; padding: 4rem 0; }
.about-hero h1 { font-weight: 800; font-size: clamp(1.75rem, 4vw, 2.5rem); }
.about-subtitle { color: rgba(255,255,255,0.7); font-size: 1.05rem; }

.about-stat-box      { background: #fff; border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius); padding: 1.5rem; text-align: center; transition: var(--ct-transition); }
.about-stat-box:hover { border-color: var(--ct-primary); box-shadow: var(--ct-shadow-pink); }
.about-stat-num      { font-size: 1.85rem; font-weight: 800; color: var(--ct-primary); line-height: 1.1; }
.about-stat-label    { font-size: 0.85rem; color: var(--ct-muted); margin-top: 0.25rem; }

.about-usp-card      { background: var(--ct-primary-soft); border-radius: var(--ct-radius); padding: 1.5rem; text-align: center; border: 1.5px solid var(--ct-primary-light); height: 100%; transition: var(--ct-transition); }
.about-usp-card:hover { background: var(--ct-primary); color: #fff; }
.about-usp-icon      { font-size: 2.2rem; color: var(--ct-primary); margin-bottom: 0.75rem; transition: var(--ct-transition); }
.about-usp-card:hover .about-usp-icon { color: #fff; }
.about-usp-title     { font-weight: 700; font-size: 0.95rem; margin-bottom: 0.35rem; }

/* ===================================================
   ADMIN — Quick Action cards
   =================================================== */
.quick-action-card { background: #fff; border: none; border-radius: var(--ct-radius); box-shadow: 0 1px 4px rgba(0,0,0,0.06); text-align: center; padding: 1.5rem; }

.qa-icon-wrap {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 12px;
  margin-bottom: 0.75rem;
}

.qa-icon-wrap.pink   { background: var(--ct-primary-light); }
.qa-icon-wrap.green  { background: #d1fae5; }
.qa-icon-wrap.blue   { background: #dbeafe; }
.qa-icon-wrap.yellow { background: #fef3c7; }

.qa-icon-wrap i { font-size: 1.6rem; }
.qa-icon-wrap.pink   i { color: var(--ct-primary); }
.qa-icon-wrap.green  i { color: #065f46; }
.qa-icon-wrap.blue   i { color: #1d4ed8; }
.qa-icon-wrap.yellow i { color: #92400e; }

.qa-desc { font-size: 0.82rem; }

/* ===================================================
   ADMIN — Low Stock item row
   =================================================== */
.low-stock-icon {
  width: 40px;
  height: 40px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.low-stock-icon.pink   { background: var(--ct-primary-light); }
.low-stock-icon.blue   { background: #dbeafe; }
.low-stock-icon.yellow { background: #fef3c7; }
.low-stock-icon.green  { background: #d1fae5; }

.low-stock-icon i { font-size: 1.1rem; }
.low-stock-icon.pink   i { color: var(--ct-primary); }
.low-stock-icon.blue   i { color: #1d4ed8; }
.low-stock-icon.yellow i { color: #92400e; }
.low-stock-icon.green  i { color: #065f46; }

.low-stock-name { font-size: 0.85rem; font-weight: 600; }
.low-stock-qty  { font-size: 0.76rem; color: var(--ct-muted); }

/* ===================================================
   ADMIN — Table cell text helpers
   =================================================== */
.td-id       { font-size: 0.83rem; font-weight: 600; }
.td-name     { font-size: 0.83rem; }
.td-meta     { font-size: 0.82rem; color: var(--ct-muted); }
.td-price    { font-size: 0.83rem; font-weight: 600; }
.td-sm-badge { font-size: 0.72rem; }

/* Alert icon in admin */
.alert-icon-blue { color: #1d4ed8; }


/* ===================================================
   ADMIN — Status badge colours (static, non-JS)
   =================================================== */
.badge-status-processing { background: #dbeafe; color: #1e3a8a; }
.badge-status-ready      { background: #fde68a; color: #78350f; }
.badge-status-pending    { background: #fef3c7; color: #92400e; }
.badge-status-pickup     { background: #f1f5f9; color: #475569; }
.badge-status-delivery   { background: #e0f2fe; color: #0369a1; }
.badge-status-completed  { background: #d1fae5; color: #065f46; }
.badge-status-cancelled  { background: #fee2e2; color: #991b1b; }

/* ===================================================
   CHECKOUT / TRACK — info panel and helpers
   =================================================== */
.checkout-page-title      { font-size: 1.6rem; font-weight: 800; }
.checkout-page-icon       { color: var(--ct-primary); }
.submit-btn-lg            { font-size: 1.05rem; }
.secure-form-note         { font-size: 0.78rem; color: var(--ct-muted); }
.confirm-modal-note       { font-size: 0.8rem; color: var(--ct-muted); }
.confirm-total-value      { color: var(--ct-primary); }
.payment-number           { font-size: 1rem; font-weight: 700; letter-spacing: 1px; }
.modal-gradient-header    { background: linear-gradient(135deg, var(--ct-primary), var(--ct-primary-dark)); }
.confirm-info-box         { background: var(--ct-primary-soft); border: 1.5px solid var(--ct-primary-light); border-radius: var(--ct-radius-sm); }

.track-container          { max-width: 820px; }
.track-emoji              { font-size: 2.5rem; margin-bottom: 0.5rem; }
.track-info-icon          { font-size: 1.8rem; color: var(--ct-primary); margin-bottom: 0.5rem; }
.track-info-label         { font-size: 0.9rem; font-weight: 700; }
.track-info-text          { font-size: 0.78rem; color: var(--ct-muted); margin-top: 0.25rem; }
.track-info-panel         { background: var(--ct-primary-soft); border: 1.5px solid var(--ct-border); border-radius: var(--ct-radius-sm); padding: 1rem; }
.track-action-link        { color: var(--ct-primary); text-decoration: none; font-weight: 600; }
.track-action-link:hover  { text-decoration: underline; }
.hist-msg-note            { color: var(--ct-muted); }
.status-fill-bar          { left: calc(10% + 10px); }


/* ===================================================
   PRODUCT DETAIL PAGE
   =================================================== */
.product-gallery { position: sticky; top: 90px; }

.gallery-main {
  border: 1.5px solid var(--ct-border);
  border-radius: var(--ct-radius);
  overflow: hidden;
  background: var(--ct-primary-soft);
}

.gallery-main img { display: block; width: 100%; object-fit: cover; max-height: 440px; }

.gallery-thumb {
  background: #fff;
  border: 2px solid var(--ct-border);
  border-radius: var(--ct-radius-sm);
  padding: 3px;
  cursor: pointer;
  transition: var(--ct-transition);
  width: 72px;
  height: 72px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.gallery-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 4px; }

.gallery-thumb:hover,
.gallery-thumb.active { border-color: var(--ct-primary); box-shadow: 0 0 0 3px rgba(233,30,140,0.18); }

/* Color option buttons on product page */
.color-option-btn {
  display: flex;
  align-items: center;
  gap: 0.45rem;
  cursor: pointer;
  padding: 0.35rem 0.75rem;
  border: 2px solid var(--ct-border);
  border-radius: 999px;
  transition: var(--ct-transition);
  user-select: none;
}

.color-option-btn:hover    { border-color: var(--ct-primary); }
.color-option-btn.active   { border-color: var(--ct-primary); background: var(--ct-primary-soft); }

/* Storage button active state */
.storage-btn.active { background: var(--ct-primary) !important; color: #fff !important; border-color: var(--ct-primary) !important; }
